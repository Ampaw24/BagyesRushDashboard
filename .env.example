# Base URL of the Laravel API (bagyes-rush-backend).
# No trailing slash, no /api/v1 suffix — the client appends that itself.
#
# Server-only on purpose: it is NOT prefixed with NEXT_PUBLIC_, so neither the
# URL nor the admin's bearer token is ever included in the browser bundle.
#
# `php artisan serve` default:
API_BASE_URL=http://127.0.0.1:8000

# --- Pointing `npm run dev` at a local backend -------------------------------
#
# Put local overrides in `.env.development.local` rather than editing
# `.env.local`. Next loads it first and lets it win, but ONLY for `next dev` —
# so a production build keeps reading `.env.local` and the live API, and there
# is no deploy-time footgun. To go back to developing against production,
# rename that file and restart the dev server.
#
# A working local set, alongside `php artisan serve` in bagyes-rush-backend:
#
#   API_BASE_URL=http://127.0.0.1:8000
#   SESSION_COOKIE_SECURE=false
#   NEXT_PUBLIC_REVERB_KEY=local-development-key
#   NEXT_PUBLIC_REVERB_HOST=localhost
#   NEXT_PUBLIC_REVERB_PORT=8080
#   NEXT_PUBLIC_REVERB_SCHEME=http
#
# SESSION_COOKIE_SECURE must be false locally: a browser refuses to store a
# Secure cookie over plain HTTP, so sign-in would appear to work and then bounce
# straight back to the login screen.
#
# Signing in locally is the same two-step flow as production — password, then a
# code. With no SMS provider key set the backend binds LogOtpClient, so no text
# is sent and nothing is charged; read the code out of the backend's
# storage/logs/laravel.log instead.

# The public origin this dashboard is served from, e.g.
# https://admin.bagyesrushdelivery.com — scheme and host, no trailing slash.
#
# Only `proxy.ts` needs it, and only because Next refuses a relative `Location`
# from middleware: every other redirect in the app is relative and never has to
# know the host. Left unset, the origin is inferred from `X-Forwarded-Host` /
# `X-Forwarded-Proto` and then the `Host` header, which works but trusts
# whatever the proxy sends.
#
# Worth setting in production. A spoofed `X-Forwarded-Host` decides where a
# signed-out visitor's browser is sent, and stating the origin once closes that.
# APP_ORIGIN=https://admin.bagyesrushdelivery.com

# Whether the session cookie is marked `Secure`. Normally left unset: it is
# derived from the request's x-forwarded-proto, so it turns itself on once the
# dashboard is served over HTTPS.
#
# Set it explicitly only when TLS terminates somewhere that does not forward
# that header — `true` behind such a proxy, `false` to keep sign-in working on a
# plain-HTTP host (a browser refuses to store a Secure cookie over HTTP).
# SESSION_COOKIE_SECURE=true

# Origin static assets are served from, when that differs from where the app
# itself is served. Applied only to a production build — `next dev` always
# serves its own assets, so leave this unset locally or the page loads
# unstyled.
#
# ASSET_PREFIX=http://31.187.74.65:8087

# --- Live rider map (Laravel Reverb) -----------------------------------------
#
# The websocket is opened by the BROWSER, so unlike API_BASE_URL these four are
# NEXT_PUBLIC_ and that is correct. The app key identifies the application; it
# authorises nothing. The app *secret* stays on the Laravel server and must
# never appear here.
#
# The admin's bearer token still never reaches the browser: Echo authorises
# private channels through /api/broadcasting/auth on this app, which reads the
# httpOnly cookie server-side and forwards it.
#
# Leave these blank and the map still renders from the seed list — it just says
# "Live updates off" and the markers do not move.
#
# HOST/PORT/SCHEME are what the browser dials, which behind a reverse proxy is
# not what `php artisan reverb:start` binds to.
NEXT_PUBLIC_REVERB_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
