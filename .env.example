# Base URL of the Laravel API (bagyes-rush-backend).
# No trailing slash, no /api/v1 suffix — the client appends that itself.
#
# Server-only on purpose: it is NOT prefixed with NEXT_PUBLIC_, so neither the
# URL nor the admin's bearer token is ever included in the browser bundle.
#
# `php artisan serve` default:
API_BASE_URL=http://127.0.0.1:8000
