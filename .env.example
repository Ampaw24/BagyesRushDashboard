# Base URL of the Laravel API (bagyes-rush-backend).
# No trailing slash, no /api/v1 suffix — the client appends that itself.
#
# Server-only on purpose: it is NOT prefixed with NEXT_PUBLIC_, so neither the
# URL nor the admin's bearer token is ever included in the browser bundle.
#
# `php artisan serve` default:
API_BASE_URL=http://127.0.0.1:8000

# Whether the session cookie is marked `Secure`. Normally left unset: it is
# derived from the request's x-forwarded-proto, so it turns itself on once the
# dashboard is served over HTTPS.
#
# Set it explicitly only when TLS terminates somewhere that does not forward
# that header — `true` behind such a proxy, `false` to keep sign-in working on a
# plain-HTTP host (a browser refuses to store a Secure cookie over HTTP).
# SESSION_COOKIE_SECURE=true

# Origin static assets are served from, when that differs from where the app
# itself is served. Applied only to a production build — `next dev` always
# serves its own assets, so leave this unset locally or the page loads
# unstyled.
#
# ASSET_PREFIX=http://31.187.74.65:8087
